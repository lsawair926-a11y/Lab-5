#include "mbed.h"
#include "arm_book_lib.h"



#define NUMBER_OF_KEYS                           4
#define OVER_TEMP_LEVEL                         50
#define TIME_INCREMENT_MS                       10
#define DEBOUNCE_KEY_TIME_MS                    40
#define KEYPAD_NUMBER_OF_ROWS                    4
#define KEYPAD_NUMBER_OF_COLS                    4
#define EVENT_MAX_STORAGE                        5   


typedef enum {
    MATRIX_KEYPAD_SCANNING,
    MATRIX_KEYPAD_DEBOUNCE,
    MATRIX_KEYPAD_KEY_HOLD_PRESSED
} matrixKeypadState_t;

typedef struct {
    float temperature;   
    float gasReading;    
    int   eventNumber;   
} alarmEvent_t;

DigitalIn alarmTestButton(BUTTON1);
AnalogIn mq2(A2);

DigitalOut alarmLed(LED1);
DigitalOut incorrectCodeLed(LED3);

DigitalInOut sirenPin(PE_10);

UnbufferedSerial uartUsb(USBTX, USBRX, 115200);

AnalogIn lm35(A1);
AnalogIn potentiometer(A0);


DigitalOut keypadRowPins[4] = {PB_3, PB_5, PC_7, PA_15};
DigitalIn keypadColPins[4]  = {PB_12, PB_13, PB_15, PC_6};


bool alarmState       = OFF;
bool alarmTriggered   = false;
bool messageDisplayed = false;

int numberOfIncorrectCodes      = 0;
int numberOfHashKeyReleasedEvents = 0;

char codeSequence[4] = {'1','8','0','5'};
char keyPressed[4]   = {'0','0','0','0'};
int matrixKeypadCodeIndex = 0;

float lm35TempC = 0;

int  debounceTime = 0;
char lastKey = '\0';

matrixKeypadState_t matrixKeypadState;

float tempThreshold     = 45.0;
float gasThreshold      = 400.0;
float potValue          = 0.0;
float lastTempThreshold = -1;
float lastGasThreshold  = -1;


alarmEvent_t eventLog[EVENT_MAX_STORAGE];
int eventsIndex       = 0;   
int totalEventsStored = 0;  
int eventCounter      = 0;   


void matrixKeypadInit();
char matrixKeypadScan();
char matrixKeypadUpdate();
bool areEqual();
void logAlarmEvent(float temp, float gas);   
void displayEventLog();                      

int main()
{
    alarmTestButton.mode(PullDown);
    sirenPin.mode(OpenDrain);
    sirenPin.input();
    matrixKeypadInit();

    while (true) {

        
        potValue = potentiometer.read();
       
        tempThreshold = 25.0 + potValue * (37.0 - 25.0);

      
        gasThreshold = 100.0 + potValue * 700.0;  

        if (fabs(tempThreshold - lastTempThreshold) > 0.5 ||
            fabs(gasThreshold - lastGasThreshold) > 10) {

            printf("Temp Threshold: %.2f C | Gas Threshold: %.0f ppm\n",
                   tempThreshold, gasThreshold);

            lastTempThreshold = tempThreshold;
            lastGasThreshold  = gasThreshold;
        }

        lm35TempC = (lm35.read() * 3.3 / 0.01)- 10.0;

        float gasValue = mq2.read();  

        bool newTrigger = false;

        if (lm35TempC > tempThreshold) {
            newTrigger = true;
        }

        if (gasValue * 800.0 > gasThreshold) {
            newTrigger = true;
        }

        if (alarmTestButton) {
            newTrigger = true;
        }

if (newTrigger && !alarmTriggered) {
    alarmState     = ON;
    alarmTriggered = true;

    printf("\n--- ALARM TRIGGERED ---\n");

    if (lm35TempC > tempThreshold) {
        printf("REASON: Temperature too high!\n");
        printf("  Current Temp:      %.2f C\n", lm35TempC);
        printf("  Temp Threshold:    %.2f C\n", tempThreshold);
    }

    if (gasValue * 800.0 > gasThreshold) {
        printf("REASON: Gas detected!\n");
        printf("  Current Gas:       %.0f ppm\n", gasValue * 800.0);
        printf("  Gas Threshold:     %.0f ppm\n", gasThreshold);
    }

    if (alarmTestButton) {
        printf("REASON: Test button pressed.\n");
    }

    printf("-----------------------\n\n");

  
    logAlarmEvent(lm35TempC, gasValue);
}
      
        if (alarmState) {

            if (!messageDisplayed) {
                printf("Enter 4-Digit Code to Deactivate\n");
                messageDisplayed = true;
            }

            sirenPin.output();
            sirenPin = LOW;
            alarmLed = !alarmLed;

        } else {

            messageDisplayed = false;  

            sirenPin.input();
            alarmLed = OFF;
        }

        
        char key = matrixKeypadUpdate();

   
        if (key != '\0' && key != '#') {
            printf("Key: %c\n", key);
            if (matrixKeypadCodeIndex < NUMBER_OF_KEYS) {
                keyPressed[matrixKeypadCodeIndex] = key;
                matrixKeypadCodeIndex++;
            }
        }

  
        if (key == '#') {

            if (!alarmState) {
         
                displayEventLog();

            } else {
               
                printf("Entered: %c%c%c%c\n",
                    keyPressed[0], keyPressed[1],
                    keyPressed[2], keyPressed[3]);

                if (areEqual()) {

                    printf("Correct code — alarm deactivated.\n");

                    alarmState             = OFF;
                    alarmTriggered         = false;
                    incorrectCodeLed       = OFF;
                    numberOfIncorrectCodes = 0;

                } else {

                    printf("Incorrect code! Try again.\n");

                    incorrectCodeLed = ON;
                    numberOfIncorrectCodes++;
                }

              
                matrixKeypadCodeIndex = 0;
                for (int i = 0; i < 4; i++) keyPressed[i] = '0';
            }
        }

        delay(TIME_INCREMENT_MS);
    }
}



void logAlarmEvent(float temp, float gas)
{
    eventCounter++;

    eventLog[eventsIndex].temperature = temp;
    eventLog[eventsIndex].gasReading  = gas;
    eventLog[eventsIndex].eventNumber = eventCounter;

  
    eventsIndex = (eventsIndex + 1) % EVENT_MAX_STORAGE;


    if (totalEventsStored < EVENT_MAX_STORAGE) {
        totalEventsStored++;
    }

    printf("Event logged. Total stored: %d\n", totalEventsStored);
}


void displayEventLog()
{
    printf("\n--- Event Log (Last %d Events) ---\n", EVENT_MAX_STORAGE);

    if (totalEventsStored == 0) {
        printf("No events recorded yet.\n");
        printf("----------------------------------\n\n");
        return;
    }


    int startIndex = 0;
    int count      = totalEventsStored;

    if (totalEventsStored >= EVENT_MAX_STORAGE) {
    
        startIndex = eventsIndex;
        count      = EVENT_MAX_STORAGE;
    }

    for (int i = 0; i < count; i++) {
        int idx = (startIndex + i) % EVENT_MAX_STORAGE;

        printf("Event %d:\n",   eventLog[idx].eventNumber);
        printf("  Temp:    %.2f C\n",   eventLog[idx].temperature);
        printf("  Gas:     %.3f (raw) = %.0f ppm\n",
               eventLog[idx].gasReading,
               eventLog[idx].gasReading * 800.0);
        printf("\n");
    }

    printf("----------------------------------\n\n");
}



void matrixKeypadInit()
{
    matrixKeypadState = MATRIX_KEYPAD_SCANNING;
    for (int i = 0; i < 4; i++) {
        keypadColPins[i].mode(PullUp);
    }
}

char matrixKeypadScan()
{
    char keys[16] = {
        '1','2','3','A',
        '4','5','6','B',
        '7','8','9','C',
        '*','0','#','D'
    };

    for (int row = 0; row < 4; row++) {
        for (int i = 0; i < 4; i++) keypadRowPins[i] = 1;
        keypadRowPins[row] = 0;

        for (int col = 0; col < 4; col++) {
            if (keypadColPins[col] == 0) {
                return keys[row * 4 + col];
            }
        }
    }
    return '\0';
}

char matrixKeypadUpdate()
{
    char key = '\0';

    switch (matrixKeypadState) {

        case MATRIX_KEYPAD_SCANNING:
            key = matrixKeypadScan();
            if (key != '\0') {
                lastKey      = key;
                debounceTime = 0;
                matrixKeypadState = MATRIX_KEYPAD_DEBOUNCE;
            }
            break;

        case MATRIX_KEYPAD_DEBOUNCE:
            debounceTime += TIME_INCREMENT_MS;
            if (debounceTime >= DEBOUNCE_KEY_TIME_MS) {
                if (matrixKeypadScan() == lastKey) {
                    matrixKeypadState = MATRIX_KEYPAD_KEY_HOLD_PRESSED;
                } else {
                    matrixKeypadState = MATRIX_KEYPAD_SCANNING;
                }
            }
            break;

        case MATRIX_KEYPAD_KEY_HOLD_PRESSED:
            if (matrixKeypadScan() != lastKey) {
                matrixKeypadState = MATRIX_KEYPAD_SCANNING;
                return lastKey;
            }
            break;
    }

    return '\0';
}


bool areEqual()
{
    for (int i = 0; i < 4; i++) {
        if (codeSequence[i] != keyPressed[i]) return false;
    }
    return true;
}


